# Template for the local .env file. Copy this to .env and replace every
# <placeholder> with a real value. Do not commit .env - it is gitignored.

# YouTube Data API v3. API_KEY is created in Google Cloud Console with the
# YouTube Data API v3 enabled. CHANNEL_HANDLE has no leading "@".
API_KEY=<your-youtube-data-api-key>
YT_URL=https://youtube.googleapis.com/youtube/v3
CHANNEL_HANDLE=naveenautomationlabs

# DockerHub image
DOCKERHUB_NAMESPACE=<your-dockerhub-username>
DOCKERHUB_REPOSITORY=yt-elt
IMAGE_TAG=1.0.0

# Postgres connection - POSTGRES_CONN_USERNAME set to the default postgres user
# to not create another db. POSTGRES_CONN_HOST is the Postgres service name.
POSTGRES_CONN_USERNAME=postgres
POSTGRES_CONN_PASSWORD=<postgres-superuser-password>
POSTGRES_CONN_HOST=postgres
POSTGRES_CONN_PORT=5432

# Metadata database credentials - Airflow's own state lives here
METADATA_DATABASE_NAME=airflow_metadata_db
METADATA_DATABASE_USERNAME=airflow_meta_user
METADATA_DATABASE_PASSWORD=<metadata-db-password>

# Celery database credentials - Celery result backend
CELERY_BACKEND_NAME=celery_results_db
CELERY_BACKEND_USERNAME=celery_user
CELERY_BACKEND_PASSWORD=<celery-backend-password>

# ELT database credentials - where the extracted YouTube data is loaded
ELT_DATABASE_NAME=elt_db
ELT_DATABASE_USERNAME=yt_api_user
ELT_DATABASE_PASSWORD=<elt-db-password>

# Airflow params
# AIRFLOW_UID must match the host user that owns the mounted volumes. On Linux
# and WSL use the output of `id -u`; on Windows/macOS Docker Desktop keep 50000.
AIRFLOW_UID="50000"
AIRFLOW_WWW_USER_USERNAME="airflow"
AIRFLOW_WWW_USER_PASSWORD=<airflow-ui-password>
# Encrypts Airflow connections and variables at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this later makes existing encrypted values unreadable - see
# `airflow rotate-fernet-key` if you need to rotate it.
FERNET_KEY="<generated-fernet-key>"
